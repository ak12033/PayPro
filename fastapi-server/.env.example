# ─────────────────────────────────────────────────────────────
# PayPro AI service — environment
# Copy to `.env` and fill in.
#
# This service is called directly by the browser for AI features and
# server-to-server by the Node backend for transaction scoring, so it needs
# its own database, auth and AI-provider configuration.
#
# To keep this file OUTSIDE the source tree (recommended — see README
# "Secrets"), start the service with ENV_FILE=/path/to/paypro-ai.env set in
# the shell. ENV_FILE itself cannot go in this file.
# ─────────────────────────────────────────────────────────────

ENVIRONMENT=development

# ── AI provider ──────────────────────────────────────────────
# Required. The service exits at startup if this is missing, rather than
# failing silently on every request. Never expose this to the browser.
GEMINI_API_KEY=

# ── Database ─────────────────────────────────────────────────
# THE SAME cluster the Node backend uses — same data, no copy. Give the URI
# without a trailing database name; MONGO_DB_NAME selects the database.
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DB_NAME=PayPro

# ── Authentication ───────────────────────────────────────────
# Required, and must be byte-identical to JWT_SECRET in server/.env: this
# service verifies the very same access tokens the Node backend signs.
JWT_SECRET=

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call this service directly.
# Required in production. Defaults to http://localhost:5173 elsewhere.
ALLOWED_ORIGINS=http://localhost:5173

# ── Server-to-server ─────────────────────────────────────────
# Shared secret for /ai/categorize and /ai/fraud-check, which the Node ledger
# calls during money movement — must match FASTAPI_API_KEY in server/.env.
# Required in production.
FASTAPI_API_KEY=

# ── Error tracking (optional) ────────────────────────────────
# Sentry DSN. Unset = error tracking off (the SDK is not even loaded). Events
# are scrubbed of amounts, balances, emails, IPs and credentials before they
# leave the process (app/observability.py).
SENTRY_DSN=
# SENTRY_ENVIRONMENT=          # defaults to ENVIRONMENT
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0  # performance tracing; off by default

# ── Limits (optional; defaults shown) ────────────────────────
# Per-user ceiling on browser-facing AI calls, matching the limiter the Node
# backend used to apply to these routes.
AI_RATE_LIMIT=25
AI_RATE_WINDOW_S=300
MAX_REQUEST_BYTES=102400
