# ─────────────────────────────────────────────────────────────
# PayPro AI service — environment
# Copy to `.env` and fill in.
# ─────────────────────────────────────────────────────────────

ENVIRONMENT=development

# Required. The service exits at startup if this is missing, rather than
# failing silently on every request.
GEMINI_API_KEY=

# Shared secret with the Node backend — must match FASTAPI_API_KEY there.
# Required in production; without it this service is an open, billable
# Gemini proxy for anyone who can reach its URL.
FASTAPI_API_KEY=

# Comma-separated browser origins. Normally left EMPTY: only the Node
# backend should call this service, server-to-server.
ALLOWED_ORIGINS=
