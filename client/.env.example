# ─────────────────────────────────────────────────────────────
# PayPro client — environment
#
# Copy to `.env` (the leading dot matters — Vite only reads `.env*`).
#
# WARNING: everything here is compiled into the JavaScript bundle and is
# publicly readable. Only ever put publishable/public keys in this file.
# ─────────────────────────────────────────────────────────────

VITE_BACKEND_URL=http://localhost:5000

# Razorpay *publishable* key id (rzp_test_… / rzp_live_…).
# The key SECRET must never appear here.
VITE_RAZORPAY_KEY_ID=

# Firebase web config — safe to expose; access is governed by Firebase
# security rules, not by hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push certificate key pair, from Firebase Console → Cloud Messaging.
VITE_FIREBASE_VAPID_KEY=
