# ─────────────────────────────────────────────────────────────
# PayPro client — environment
#
# Copy to `.env` (the leading dot matters — Vite only reads `.env*`).
#
# WARNING: everything here is compiled into the JavaScript bundle and is
# publicly readable. Only ever put publishable/public keys in this file.
# ─────────────────────────────────────────────────────────────

VITE_BACKEND_URL=http://localhost:5000

# The AI service. The browser calls it directly for the assistant and for
# spending insights; everything else still goes to VITE_BACKEND_URL.
VITE_FASTAPI_URL=http://localhost:8000

# Razorpay *publishable* key id (rzp_test_… / rzp_live_…).
# The key SECRET must never appear here.
VITE_RAZORPAY_KEY_ID=

# Consumer-wallet screens (DEC-02 freeze). Unset: off in production builds, on
# in `npm run dev` and tests. Must agree with the API's CONSUMER_WALLET_ENABLED.
# VITE_CONSUMER_WALLET_ENABLED=true

# Firebase web config — safe to expose; access is governed by Firebase
# security rules, not by hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push certificate key pair, from Firebase Console → Cloud Messaging.
VITE_FIREBASE_VAPID_KEY=

# Error tracking (optional). A Sentry DSN is public by design — it only allows
# sending events. Unset = off, and the SDK is never downloaded. Events are
# scrubbed of amounts, balances, emails and IPs first (src/services/errorTracking.js).
VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=   # defaults to the Vite mode
# VITE_SENTRY_RELEASE=
