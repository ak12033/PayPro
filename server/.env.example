# ─────────────────────────────────────────────────────────────
# PayPro API — environment
#
# Copy to `.env` (the leading dot matters — dotenv does not read a file
# named `env`) and fill in real values. Never commit the filled-in file.
# ─────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# MongoDB connection string WITHOUT a trailing database name — the app appends
# `/PayPro`. Must be a replica set (Atlas always is): the ledger uses
# multi-document transactions, which standalone mongod does not support.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Signing key for access tokens. Minimum 32 chars; the server refuses to boot
# in production below that. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated allow-list of browser origins. Required in production.
CORS_ORIGIN=http://localhost:5173

# ── Email (OTP delivery) ─────────────────────────────────────
# Gmail requires an App Password, not your account password.
# If unset, OTPs are printed to the console in development.
EMAIL_USER=
EMAIL_PASS=

# ── Razorpay ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the Razorpay dashboard → Settings → Webhooks. The webhook handler
# rejects every request when this is unset.
RAZORPAY_WEBHOOK_SECRET=

# ── Firebase Admin (push notifications) ──────────────────────
# The full service-account JSON on ONE line, or base64-encoded.
# Base64 is more reliable — most hosts mangle embedded newlines:
#   base64 -w0 service-account.json
# Leave blank to run with push notifications mocked.
FIREBASE_SERVICE_ACCOUNT=

# ── AI ───────────────────────────────────────────────────────
# Used by the in-process assistant (tool calling).
GEMINI_API_KEY=
# The FastAPI microservice for categorisation / fraud / insights.
FASTAPI_URL=http://localhost:8000
# Shared secret; must match FASTAPI_API_KEY in the FastAPI service.
# Generate with: node -e "console.log(require('crypto').randomUUID())"
FASTAPI_API_KEY=

# ── Login security ───────────────────────────────────────────
# Every value below has a working default in config/security.js. Set one only
# when you want to move the policy — and move it while watching the challenge
# rate, because the cost of getting it wrong is asymmetric: too strict and users
# learn to click through prompts, too loose and the prompts stop protecting
# anything.

# Key used to hash device fingerprints. Derived from JWT_SECRET when unset, so
# it is safe to leave blank. Changing either value invalidates every stored
# fingerprint: users are challenged once and re-trust their devices.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_FINGERPRINT_SECRET=

# Two sign-ins within this many km are "the same place". IP geolocation
# resolves to a city centroid, so anything tighter challenges people who never
# left the room. Recommended range 100-200.
LOGIN_SAME_LOCATION_RADIUS_KM=100
# Still plausibly a commute. Beyond this, a move counts as significant.
LOGIN_NEARBY_RADIUS_KM=200

# Trust lapses after this many days of inactivity on a device.
TRUSTED_DEVICE_INACTIVITY_DAYS=90

# Risk score (0-100) at which a second factor is demanded. Note that the hard
# triggers below fire regardless of the score.
LOGIN_RISK_THRESHOLD=50

# Signal weights. Negative removes risk.
#   RISK_W_TRUSTED_DEVICE=-30    RISK_W_KNOWN_LOCATION=-20
#   RISK_W_NEW_DEVICE=40         RISK_W_DIFFERENT_CITY=20
#   RISK_W_DIFFERENT_STATE=30    RISK_W_DIFFERENT_COUNTRY=40
#   RISK_W_IMPOSSIBLE_TRAVEL=50  RISK_W_SUSPECTED_PROXY=30

# Conditions that demand 2FA whatever the score says. Turning one off hands
# that decision back to the arithmetic.
#   RISK_HARD_NEW_DEVICE=true    RISK_HARD_UNTRUSTED_DEVICE=true
#   RISK_HARD_EXPIRED_TRUST=true RISK_HARD_LOCATION_CHANGE=true
#   RISK_HARD_IMPOSSIBLE_TRAVEL=true
# Off by default: a VPN is common, legitimate user behaviour.
RISK_HARD_SUSPECTED_PROXY=false

# ── Operations ───────────────────────────────────────────────
# Set to 'false' on every replica except one, so scheduled reminders are not
# sent once per running instance.
ENABLE_CRON=true
CRON_TIMEZONE=Asia/Kolkata
# debug | info | warn | error
LOG_LEVEL=info
