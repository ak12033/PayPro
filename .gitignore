# Node.js
node_modules/
npm-debug.log*

# Environment files
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
venv/
.venv/

# Logs
logs/
*.log

# Build folders
dist/
build/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Firebase Service Account
#
# Matched in ANY directory, not just server/config/. The credential is normally
# downloaded to the repo root, which the previous server/config-only patterns
# did not cover — one `git add .` would have committed a live private key.
*firebase-adminsdk*.json
*service-account*.json
*service_account*.json
*serviceAccount*.json
**/*firebase*adminsdk*.json

# Private keys and certificates bundles. server/utils/secretHygiene.js looks
# for the same names — keep the two lists in step.
*.pem
*.p12
*.pfx
*.key

# Local working notes
#
# Root-anchored so a legitimately-tracked plan.md or context.md inside a
# subdirectory is unaffected.
/plan.md
/context.md